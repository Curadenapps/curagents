{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "f=\"$CLAUDE_PROJECT_DIR/scripts/sync-checkout.sh\"; [ -f \"$f\" ] && bash \"$f\"; exit 0",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
